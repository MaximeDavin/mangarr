{
  "name": "mangarr",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun run --parallel --filter @mangarr/server --filter @mangarr/web dev",
    "build": "bun run --filter @mangarr/web build",
    "start": "bun run --filter @mangarr/server start",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "auth:reset": "bun run --filter @mangarr/server auth:reset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  }
}
